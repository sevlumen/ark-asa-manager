# Copy this file to compose.secrets.yml and provide the two host-side secret
# files through ARK_*_SECRET_FILE. Never commit those files.
services:
  ark:
    environment:
      ARK_ADMIN_PASSWORD_FILE: /run/secrets/ark_admin_password
      ARK_SERVER_PASSWORD_FILE: /run/secrets/ark_server_password
    volumes:
      - type: bind
        source: ${ARK_ADMIN_PASSWORD_SECRET_FILE:?set ARK_ADMIN_PASSWORD_SECRET_FILE}
        target: /run/secrets/ark_admin_password
        read_only: true
      - type: bind
        source: ${ARK_SERVER_PASSWORD_SECRET_FILE:?set ARK_SERVER_PASSWORD_SECRET_FILE}
        target: /run/secrets/ark_server_password
        read_only: true
